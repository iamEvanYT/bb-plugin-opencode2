{
  "name": "bb-plugin-opencode2",
  "version": "1.1.0",
  "description": "BB plugin that runs threads through an installed OpenCode v2 server.",
  "keywords": [
    "bb-plugin",
    "opencode",
    "provider"
  ],
  "homepage": "https://github.com/iamEvanYT/bb-plugin-opencode2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamEvanYT/bb-plugin-opencode2.git"
  },
  "bugs": {
    "url": "https://github.com/iamEvanYT/bb-plugin-opencode2/issues"
  },
  "author": {
    "name": "Evan",
    "url": "https://github.com/iamEvanYT"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.6.49"
  },
  "scripts": {
    "build": "bb plugin build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.ts && vitest run tests/app.test.tsx",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "bb": {
    "name": "OpenCode v2",
    "description": "Run BB threads through an installed OpenCode v2 server.",
    "branding": {
      "icon": "./icons/opencode.svg"
    },
    "server": "./src/server.ts",
    "host": "./src/host.ts",
    "app": "./src/app.tsx"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@radix-ui/react-slot": "^1.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.13.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.7"
  }
}
